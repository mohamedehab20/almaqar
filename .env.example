# Copy to .env.local and fill in from the Supabase dashboard.
# Never commit .env.local.

# Project Settings > API: Project URL and the publishable (or legacy "anon") key.
# Safe for the browser — access is limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Connect > ORMs (Drizzle) > Transaction pooler connection string (port 6543).
# Server-only: bypasses RLS. Used by drizzle-kit migrations and trusted server code.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Project Settings > API Keys: secret key (or legacy "service_role"). Server-only, bypasses RLS.
# Optional: used to email invites to new members. Without it, invited members simply sign up with their email.
SUPABASE_SECRET_KEY=
